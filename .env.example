# --- Base de données ---
# PostgreSQL. En local : docker run --name oximmo-db -e POSTGRES_PASSWORD=oximmo -e POSTGRES_DB=oximmo -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:oximmo@localhost:5432/oximmo?schema=public"

# --- NextAuth v5 ---
# Générer une clé : openssl rand -base64 32
AUTH_SECRET="change-me-avec-openssl-rand-base64-32"
# En dev, laisser vide. En prod : https://votre-domaine.fr
# AUTH_URL="https://oximmo.fr"

# --- URL publique du site (metadata, canonical, sitemap) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudflare Turnstile (anti-spam formulaire de contact) ---
# OPTIONNEL : si non renseigné, la vérification est ignorée (utile en local).
# Clés de test Cloudflare (toujours valides) :
#   site  = 1x00000000000000000000AA
#   secret= 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Emails (notifications leads + newsletter) ---
# OPTIONNEL : si non renseigné, les emails sont journalisés mais pas envoyés
# (le site reste fonctionnel). Fournisseur : Resend (https://resend.com).
RESEND_API_KEY=""
# Adresse expéditrice vérifiée chez le fournisseur, ex. "Jerusalem Rent <no-reply@votredomaine.fr>"
EMAIL_FROM=""
# Adresse de repli pour les leads non rattachés à un agent (sinon EMAIL_FROM).
AGENCY_EMAIL=""

# --- Upload d'images admin (production uniquement) ---
# En local, vide = écriture directe dans public/uploads (comportement actuel).
# En prod sur Vercel (fs en lecture seule) : créer un store "Blob" dans le
# dashboard Vercel > Storage puis le rattacher au projet — le token est alors
# injecté automatiquement, rien à faire ici.
BLOB_READ_WRITE_TOKEN=""

# --- Géocodage (carte) ---
# Biais pays optionnel (codes ISO, séparés par des virgules).
# Vide = recherche mondiale. Pour un site Israël : "il". Israël + France : "il,fr".
GEOCODE_COUNTRYCODES="il"
# OPTIONNEL mais RECOMMANDÉ en production : clé LocationIQ (https://locationiq.com,
# 5000 req/jour gratuit) pour un géocodage fiable. Sans clé → Nominatim public,
# gratuit mais throttlé (usage léger uniquement).
LOCATIONIQ_API_KEY=""
